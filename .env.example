# Databases (Neon PostgreSQL) — connection strings
# DATABASE_URL and DIRECT_URL contain credentials. NEVER commit real values.
DATABASE_URL=
DIRECT_URL=

# Admin — used ONLY to seed the initial AdminUser (bcrypt-hashed). Remove
# ADMIN_PASSWORD from long-term config once the account is created/verified.
ADMIN_USERNAME=
ADMIN_PASSWORD=

# Session cookie HMAC signing secret (admin authentication). Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
# REQUIRED. Rotating it invalidates all existing sessions.
SESSION_SECRET=

# Content source flag: "blob" (current live system) | "db" (PostgreSQL via Prisma).
# "db" tries PostgreSQL first and falls back to Blob/JSON automatically.
# "db" is the intended future production mode after parity verification.
CONTENT_SOURCE=blob

# Vercel Blob (content + image storage — RETAINED)
BLOB_READ_WRITE_TOKEN=

# Contact form email (Gmail SMTP)
GMAIL_USER=
GMAIL_PASS=